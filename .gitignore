# 仓库级忽略规则。各子项目另有自己的 .gitignore。

# 系统文件
.DS_Store
Thumbs.db

# IDE
.idea/
*.iml
.vscode/
*.swp

# 构建产物
dist/
dist-ssr/
target/
*.log

# 本地数据库与缓存
*.db
*.db-journal
*.db-wal
*.db-shm

# 临时与备份文件
*.bak
*.bak-*
*.bak.*
.write-probe
__pycache__/
*.pyc
.docx-work/
.impeccable/
.claude/
backend/_wip/

# 本地缓存与历史备份（不进版本控制）
.vite/
frontend-vue/
frontend-vue.zip
