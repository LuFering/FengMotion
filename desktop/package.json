{
  "name": "fengmotion-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/build/main.cjs",
  "scripts": {
    "build:shell": "node scripts/build-electron.mjs",
    "resources": "node scripts/prepare-backend-resources.mjs",
    "dist": "npm --prefix ../frontend run build && npm run build:shell && npm run resources && electron-builder --config electron-builder.config.mjs --linux",
    "release": "npm run dist -- --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "~6.0.2"
  }
}
