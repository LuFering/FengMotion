    { "id": "cap-L3", "sourceUnitId": "L3", "text": "热水穿过咖啡粉，杯壁一点点变深。", "sceneId": "S03", "from": 240, "durationInFrames": 150, "readingTimeSec": 4.5 },
    { "id": "cap-L4", "sourceUnitId": "L4", "text": "牛奶落下去，白色在褐色里卷成一朵花。", "sceneId": "S04", "from": 390, "durationInFrames": 150, "readingTimeSec": 4.5 },
