  "mechanisms": [
    {
      "sceneId": "S01",
      "selected": "layered-light+mask",
      "candidates": [
        "layered-light",
        "mask",
        "video-footage"
      ],
      "reason": "先用分层光带验证“光先到”，再决定是否换实拍素材",
      "risk": "容易变成均匀晨光滤镜"
    },
    {
      "sceneId": "S02",
      "selected": "video-footage-or-local-transform",
      "candidates": [
        "video-footage",
        "local-transform",
        "mask"
      ],
      "reason": "一次机械动作需要可辨的动作峰值",
      "risk": "没有可用磨豆机素材时只能做局部运动，真实感不足"
    },
    {
      "sceneId": "S03",
      "selected": "layered-mask+path",
      "candidates": [
        "video-footage",
        "layered-mask",
        "path"
      ],
      "reason": "液体连续变化优先用遮罩/路径控制；有实拍素材则优先实拍",
      "risk": "假流动/颜色跳变"
    },
    {
      "sceneId": "S04",
      "selected": "mask+path",
      "candidates": [
        "video-footage",
        "mask",
        "path"
      ],
      "reason": "必须表现从无到有的形态形成，而不是直接显示结果",
      "risk": "纹路变成装饰动画，失去事件感"
    },
    {
      "sceneId": "S05",
      "selected": "layered-light+mask",
      "candidates": [
        "video-footage",
        "layered-light",
        "mask"
      ],
      "reason": "用光把门外与杯沿接起来，保持空间连续",
      "risk": "空间关系断裂成两个画面"
    },
    {
      "sceneId": "S06",
      "selected": "layered-transform+path",
      "candidates": [
        "video-footage",
        "layered-transform",
        "path"
      ],
      "reason": "放杯动作需要清楚开始/接触/结束与停留",
      "risk": "杯子瞬移或动作结束立即切走"
    }
  ],
