{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fengmotion.local/production-layer/production.schema.json",
  "title": "Production Plan",
  "type": "object",
  "required": [
    "version",
    "film",
    "mode",
    "brief",
    "carrier",
    "beats",
    "timing"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "film": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "directed",
        "open"
      ]
    },
    "brief": {
      "type": "string",
      "minLength": 1
    },
    "carrier": {
      "type": "object",
      "required": [
        "options",
        "chosen",
        "whyChosen",
        "risk"
      ],
      "properties": {
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "oneLine",
              "why",
              "risk"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "oneLine": {
                "type": "string"
              },
              "why": {
                "type": "string"
              },
              "risk": {
                "type": "string"
              }
            }
          }
        },
        "chosen": {
          "type": "string"
        },
        "whyChosen": {
          "type": "string"
        },
        "risk": {
          "type": "string"
        }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "order",
          "mustAchieve",
          "options",
          "chosen",
          "whyChosen"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "mustAchieve": {
            "type": "string",
            "minLength": 4
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "how",
                "why"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "how": {
                  "type": "string"
                },
                "why": {
                  "type": "string"
                }
              }
            }
          },
          "chosen": {
            "type": "string"
          },
          "whyChosen": {
            "type": "string"
          },
          "rejected": {
            "type": "string"
          }
        }
      }
    },
    "timing": {
      "type": "object",
      "required": [
        "status",
        "hardAnchors",
        "sections",
        "totalSeconds",
        "paddingCheck"
      ],
      "properties": {
        "status": {
          "enum": [
            "plan",
            "measured"
          ]
        },
        "hardAnchors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "at",
              "what"
            ],
            "properties": {
              "at": {
                "type": "number",
                "minimum": 0
              },
              "what": {
                "type": "string"
              }
            }
          }
        },
        "sections": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "name",
              "seconds",
              "why"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "why": {
                "type": "string"
              }
            }
          }
        },
        "totalSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "paddingCheck": {
          "type": "string",
          "minLength": 4
        },
        "animatic": {
          "type": "string"
        }
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "component",
          "from",
          "duration"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "component": {
            "type": "string"
          },
          "from": {
            "type": "integer",
            "minimum": 0
          },
          "duration": {
            "type": "integer",
            "minimum": 1
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "file": {
            "type": "string"
          },
          "library": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "name",
                "path",
                "how"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "template",
                    "card",
                    "scene"
                  ]
                },
                "name": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "how": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "qa": {
      "type": "object",
      "properties": {
        "frames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "motionClips": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "finalVideo": {
          "type": "string"
        }
      }
    },
    "director": {
      "type": "object",
      "required": [
        "buildabilityRisks",
        "questionsForBuilder",
        "pushbackRule"
      ],
      "properties": {
        "buildabilityRisks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "questionsForBuilder": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pushbackRule": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "library": {
      "type": "object",
      "required": [
        "searched",
        "decision",
        "reason"
      ],
      "properties": {
        "searched": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "used": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": [
              "type",
              "name",
              "path",
              "how"
            ],
            "properties": {
              "type": {
                "enum": [
                  "template",
                  "card",
                  "scene"
                ]
              },
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "how": {
                "type": "string"
              }
            }
          }
        },
        "decision": {
          "enum": [
            "used",
            "rejected"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 4
        }
      }
    },
    "probes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "path",
          "what"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "what": {
            "type": "string"
          }
        }
      }
    },
    "pushback": {
      "type": "object",
      "required": [
        "from",
        "what",
        "evidence",
        "replacement",
        "status"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "what": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "replacement": {
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "applied",
            "rejected"
          ]
        },
        "resolution": {
          "type": "string"
        },
        "approvedBy": {
          "type": "string"
        }
      }
    }
  }
}