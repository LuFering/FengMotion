    {
      "id": "A-morning-continuity",
      "title": "清晨的连续空间",
      "status": "candidate",
      "creativeThesis": "让观众像提前走进一家咖啡馆，在同一个连续空间里观察开店前几分钟的日常动作。",
      "firstImpression": "半开的卷帘门与晨光先进入画面，空间先于人物被看见。",
      "method": "narrative-observation",
      "spaceModel": "continuous-space",
      "primaryFocus": "narrative-event",
      "textRole": "preserved-poetic-text",
      "motionGrammar": [
        "light-reveals-space",
        "causal-object-motion",
        "liquid-path-change",
        "intentional-stillness"
      ],
      "materialDirection": "naturalistic",
      "contentMapping": [
        {
          "sourceUnitId": "L1",
          "visualPurpose": "建立清晨空间与光线先出现的关系"
        },
        {
          "sourceUnitId": "L2",
          "visualPurpose": "用一次声音事件改变观众的注意力"
        },
        {
          "sourceUnitId": "L3",
          "visualPurpose": "表现液体运动和可见的颜色变化"
        },
        {
          "sourceUnitId": "L4",
          "visualPurpose": "表现两种液体交汇形成的新形态"
        },
        {
          "sourceUnitId": "L5",
          "visualPurpose": "建立门外环境与杯沿光线的关系"
        },
        {
          "sourceUnitId": "L6",
          "visualPurpose": "完成放杯动作，允许观众停留在最终状态"
        }
      ],
      "candidateMediums": [
        "layered-image-assets",
        "selected-video-footage",
        "procedural-motion"
      ],
      "requiresAssetValidation": true,
      "knownRisks": [
        "spatial-continuity",
        "liquid-motion-quality",
        "character-consistency"
      ],
      "whyDistinct": "以连续空间和因果动作作为叙事单位，而不是以文字或图形作为画面主体。",
      "avoidTemplates": [
        "single-photo-push-in-with-subtitle",
        "unrelated-stock-footage-montage"
      ]
    },
    {
