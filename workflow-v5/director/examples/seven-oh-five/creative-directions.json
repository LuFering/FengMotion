        },
        {
          "sourceUnitId": "L5",
          "visualPurpose": "文字空间被门外光线推开"
        },
        {
          "sourceUnitId": "L6",
          "visualPurpose": "排版落定，回到留白"
        }
      ],
      "candidateMediums": [
        "typography-vector",
        "paper-texture",
        "procedural-graphics",
        "generated-stills"
      ],
      "requiresAssetValidation": true,
      "knownRisks": [
        "over-metaphor",
        "legibility",
        "text-image-balance"
      ],
      "whyDistinct": "文字是视觉主体，空间是排版空间，而不是写实的店内空间。",
      "avoidTemplates": [
        "subtitle-at-bottom-over-photo",
        "kinetic-type-only"
      ]
