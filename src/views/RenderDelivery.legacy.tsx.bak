import { useState } from 'react'
import { PRODUCTION_FACTS, UNITS } from '@/data/productionData'
import { statusOf, fmtDuration, type StatusKey } from '@/shell/status'
import { studioAdapter } from '@/services/studioAdapter'
import { fmtDate, type ProjectSummary } from '@/data/projects'
import type { TaskRecord } from '@/hooks/useAgentTasks'

function Icon({ name, className = 'ui-icon' }: { name: string; className?: string }) {
  return (
    <svg className={className} aria-hidden="true">
      <use href={`/assets/paba-icons.svg#${name}`} />
    </svg>
  )
}

const FILM = PRODUCTION_FACTS.activeFilmSource
/** "还在跑"= 排队/运行/构建中 —— 跑完了按钮要能再点 */
const RUNNING = ['queued', 'running', 'building']

type TabKey = 'all' | 'film' | 'comp' | 'task' | 'pending' | 'running'

interface Row {
  key: string
  kind: 'film' | 'comp' | 'task'
  name: string
  info: string
  spec: string
  thumb: string | null
  st: { label: string; s: StatusKey | 'none' }
  progress: string
  offTimeline?: boolean
  running?: boolean
  acts: React.ReactNode
}

/**
 * 发布与验收 —— 版式照《渲染示范》复刻：
 *   ① 顶部统计行（项目 / 最近改动 / 处理中 / 已完成 / 待做 / 未进时间轴）+ 右侧 暂停/开始 两个图标按钮
 *   ② 筛选胶囊行（全部 / 成片 / 合成 / 待做 / 处理中，激活项带对勾）
 *   ③ 单张表格：操作 / 类型 / 缩略图 / 名称 / 规格 / 状态 / 进度
 *   ④ 表尾说明一句话
 *
 * ⚠️ 数据真实性：
 *   · 成片 token-full-legacy.mp4 是真实文件（可下载）；V3 全片没组装 → 不给下载按钮。
 *   · 文件大小/分辨率需要读盘或媒体元数据 —— 浏览器拿不到的都写"—"，不编。
 *   · 云渲染未接入：启动渲染走演示流程（排队→进度→结束），界面上写清楚。
 */
export function RenderDelivery({ project, tasks }: { project: ProjectSummary; tasks: { records: TaskRecord[]; active: { task: { id: string; title: string; status: string } } | null; render: () => string; cancel: (id: string) => void } }) {
  const [tab, setTab] = useState<TabKey>('all')
  const [notice, setNotice] = useState('')

  const say = (msg: string) => {
    setNotice(msg)
    window.setTimeout(() => setNotice(''), 3200)
  }

  if (project.planned) {
    return (
      <div className="rdo">
        <header className="rdo-stats"><h2>{project.name}</h2><span className="rdo-meta">还没有产物</span></header>
        <div className="pj-pick">
          <h2>这个项目还没有产物</h2>
          <p>「{project.name}」是演示新建的项目，磁盘上还没有目录与合成文件，所以没有可渲染或可交付的东西。</p>
        </div>
      </div>
    )
  }

  const tracked = UNITS.filter((u) => u.compositionSrc)
  const untracked = PRODUCTION_FACTS.untrackedCompositionCount
  const doneN = UNITS.filter((u) => u.status === 'done').length
  const pendingN = UNITS.length - doneN
  const running = !!tasks.active && RUNNING.includes(tasks.active.task.status)

  // ── 行：成片 → 渲染任务 → 合成单元 ──────────────────────────
  const filmRows: Row[] = [
    {
      key: 'film-legacy',
      kind: 'film', name: 'token-full-legacy.mp4',
      info: 'HyperFrames 混合剪辑 · 含 V3 素材段 16–19；文件名与路径来自 film/index.html',
      spec: `1920×1080 · ${PRODUCTION_FACTS.legacyCutDuration.toFixed(0)}s · 大小需读盘`,
      thumb: '/frames/film/s13.jpg',
      st: { label: '可交付', s: 'done' }, progress: '100%',
      acts: (
        <>
          <a className="rdo-act" href={FILM} download="token-full-legacy.mp4" title="下载成片">
            <Icon name="download" />
          </a>
          <a className="rdo-act" href={FILM} target="_blank" rel="noreferrer" title="在新标签打开">
            <Icon name="image" />
          </a>
        </>
      ),
    },
    {
      key: 'film-v3',
      kind: 'film', name: `V3 全片 · ${PRODUCTION_FACTS.v3TargetDuration}s`,
      info: `V3 分镜表排到 253.2s（${PRODUCTION_FACTS.storyboardSegments} 段），还没组装成可播放的成片`,
      spec: `目标 ${PRODUCTION_FACTS.v3TargetDuration}s · 未组装`,
      thumb: null,
      st: { label: '未组装', s: 'waiting' }, progress: '—',
      acts: <button className="rdo-act" type="button" disabled title="等组装：需要渲染服务（云渲染未接入）"><Icon name="download" /></button>,
    },
  ]

  const taskRows: Row[] = tasks.records.map((r) => {
    const isRunning = RUNNING.includes(r.task.status)
    return {
      key: `task-${r.task.id}`,
      kind: 'task', name: r.task.title,
      info: r.events[r.events.length - 1]?.message ?? '已排队',
      spec: `${r.task.status} · ${r.task.createdAt}`,
      thumb: null,
      st: isRunning ? { label: '处理中', s: 'running' as StatusKey } : { label: r.task.status, s: 'none' as const },
      progress: isRunning ? '···' : '已结束',
      running: isRunning,
      acts: isRunning
        ? <button className="rdo-act" type="button" title="停止任务" onClick={() => tasks.cancel(r.task.id)}><Icon name="pause" /></button>
        : null,
    }
  })

  const compRows: Row[] = tracked.map((u) => {
    const st = statusOf(u.status)
    return {
      key: `u-${u.id}`,
      kind: 'comp', name: `${u.id.toUpperCase()} · ${u.label}`,
      info: `${u.title}${u.note ? ` —— ${u.note}` : ''}`,
      spec: `${u.compositionSrc} · ${fmtDuration(u.duration)}`,
      thumb: u.frame,
      st: { label: st.label, s: st.s as StatusKey },
      progress: '—',
      offTimeline: !u.inTimeline,
      acts: (
        <button className="rdo-act" type="button" title="复制合成路径"
                onClick={() => { void navigator.clipboard?.writeText(u.compositionSrc ?? ''); say(`已复制：${u.compositionSrc}`) }}>
          <Icon name="copy" />
        </button>
      ),
    }
  })

  const allRows = [...filmRows, ...taskRows, ...compRows]
  const rows: Row[] = allRows.filter((r) => {
    if (tab === 'film') return r.kind === 'film'
    if (tab === 'comp') return r.kind === 'comp'
    if (tab === 'task') return r.kind === 'task'
    if (tab === 'pending') return (r.kind === 'film' && r.st.label === '未组装') || !!r.offTimeline
    if (tab === 'running') return r.kind === 'task' && r.running
    return true
  })

  const TABS: { k: TabKey; label: string; n: number }[] = [
    { k: 'all', label: '全部', n: allRows.length },
    { k: 'film', label: '成片', n: filmRows.length },
    { k: 'comp', label: '合成', n: compRows.length },
    { k: 'task', label: '任务', n: taskRows.length },
    { k: 'pending', label: '待处理', n: allRows.filter((r) => (r.kind === 'film' && r.st.label === '未组装') || !!r.offTimeline).length },
    { k: 'running', label: '处理中', n: taskRows.filter((r) => r.running).length },
  ]

  return (
    <div className="rdo">
      {/* ── ① 统计行 + 右侧按钮组 ─────────────────────────── */}
      <header className="rdo-stats">
        <span className="rdo-meta">项目：<b>{project.name}</b></span>
        <span className="rdo-meta">最近改动 <b className="num">{fmtDate(project.updatedAt)}</b></span>
        <span className="rdo-meta">处理中 <b className="num" data-tone="acc">{running ? 1 : 0}</b></span>
        <span className="rdo-meta">已完成 <b className="num" data-tone="ok">{doneN}</b></span>
        <span className="rdo-meta">待做单元 <b className="num" data-tone="warn">{pendingN}</b></span>
        <span className="rdo-meta">未进时间轴 <b className="num">{UNITS.filter((u) => !u.inTimeline).length}</b></span>
        <span className="spacer" />
        <span className="rdo-meta rdo-caps">
          云渲染未接入 · Agent 未连接 · 本地预览{studioAdapter.capabilities.previewVideo ? '可用' : '不可用'}
        </span>
        <span className="rdo-btns">
          <button className="rdo-iconbtn" type="button" title={running ? '停止当前渲染任务' : '没有正在跑的任务'}
                  disabled={!running}
                  onClick={() => { if (tasks.active) { tasks.cancel(tasks.active.task.id); say('已请求停止（演示流程）') } }}>
            <Icon name="pause" />
          </button>
          <button className="rdo-iconbtn" type="button" data-go=""
                  title={running ? '已经在渲染了' : '启动渲染（演示：走排队→进度→结束，不调用云渲染）'}
                  disabled={running}
                  onClick={() => { tasks.render(); say('已启动渲染演示流程 —— 不调用云渲染（未接入）') }}>
            <Icon name="play" />
          </button>
        </span>
      </header>

      {/* ── ② 筛选胶囊行 ─────────────────────────────────── */}
      <div className="rdo-tabs" role="tablist" aria-label="发布与验收筛选">
        {TABS.map((t) => (
          <button key={t.k} type="button" role="tab" aria-selected={tab === t.k}
                  className="rdo-tab" data-on={tab === t.k ? '' : undefined}
                  onClick={() => setTab(t.k)}>
            {tab === t.k && <Icon name="check" />}
            {t.label}<em className="num">{t.n}</em>
          </button>
        ))}
      </div>

      {/* ── ③ 表格 ───────────────────────────────────────── */}
      <div className="rdo-tablewrap">
        <table className="rdo-table">
          <thead>
            <tr>
              <th className="rdo-th-act">操作</th>
              <th>类型</th>
              <th>缩略图</th>
              <th>名称</th>
              <th>规格</th>
              <th>状态</th>
              <th>进度</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr key={r.key} data-kind={r.kind} data-run={r.running ? '' : undefined}>
                <td className="rdo-td-act"><span className="rdo-acts">{r.acts ?? <span className="rdo-dash">—</span>}</span></td>
                <td>
                  <span className="rdo-kind">
                    <Icon name={r.kind === 'film' ? 'film' : r.kind === 'task' ? 'loader-circle' : 'clapperboard'} />
                    {r.kind === 'film' ? '成片' : r.kind === 'task' ? '任务' : '合成'}
                  </span>
                </td>
                <td>
                  <span className="rdo-thumb">
                    {r.thumb ? <img src={r.thumb} loading="lazy" alt="" /> : <Icon name="image" />}
                  </span>
                </td>
                <td className="rdo-td-name">
                  <b>{r.name}</b>
                  <Icon name="circle-help" className="ui-icon rdo-info" />
                  <span className="rdo-info-tip">{r.info}</span>
                </td>
                <td className="rdo-td-spec num">{r.spec}</td>
                <td className="rdo-td-st">
                  <span className="rdo-pill" data-s={r.st.s}>{r.st.label}</span>
                  {r.offTimeline && <i className="rdo-sub">未进时间轴</i>}
                </td>
                <td className="rdo-td-prog">
                  {r.running
                    ? <span className="rdo-progbar run"><i /><span>处理中…</span></span>
                    : r.progress === '100%'
                      ? <span className="rdo-progbar"><i style={{ width: '100%' }} /><span>100%</span></span>
                      : <span className="num">{r.progress}</span>}
                </td>
              </tr>
            ))}
            {!rows.length && (
              <tr><td colSpan={7} className="rdo-none">这个筛选下没有条目 —— 换一个筛选看看。</td></tr>
            )}
          </tbody>
        </table>
      </div>

      {/* ── ④ 表尾一句话 ─────────────────────────────────── */}
      <p className="rdo-tail">
        {doneN}/{UNITS.length} 个合成已定稿；{untracked} 个合成文件在磁盘上但没进 PROGRESS.md（不算进上面的清单）。
        文件大小需要读盘，浏览器拿不到 —— 所以不编这一列。
        <button className="rdo-copy" type="button"
                onClick={() => {
                  const lines = rows.map((r) => [r.kind, r.name, r.spec, r.st.label, r.progress].join('\t'))
                  void navigator.clipboard?.writeText(lines.join('\n'))
                  say(`已复制当前 ${rows.length} 行到剪贴板`)
                }}>
          复制本表
        </button>
        {notice && <button className="rdo-notice" type="button" onClick={() => setNotice('')}>{notice}</button>}
      </p>
    </div>
  )
}
