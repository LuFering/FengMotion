<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.fengmotion</groupId>
  <artifactId>fengmotion-server</artifactId>
  <version>0.1.0</version>
  <name>fengmotion-server</name>
  <description>FengMotion Agent backend (contract-first skeleton)</description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      启动期数据库结构迁移（ProjectDatabaseMigration）仍使用 JdbcTemplate；同时提供
      HikariCP 数据源自动配置和 spring-jdbc / spring-tx，这是 MyBatis 数据访问与
      TransactionTemplate 事务的基础。业务读写由 MyBatis / MyBatis-Plus 完成。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <!--
      SQLite 的 JDBC 驱动。Spring Boot 3.3.5 托管 3.45.3.0，这里显式固定 3.45.1.0
      以保持现有数据库与 SQLite 写锁行为不变；升级驱动应单独验证并发创建场景。
    -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.45.1.0</version>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- MyBatis-Plus：内含 MyBatis 3.5.19 与 mybatis-spring，适用于 Spring Boot 3 -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
      <version>3.5.18</version>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <!-- 开启过滤：application.yml 里的 @project.version@ 由 Maven 替换成真实版本。
             没有这一项，构建出来的包里会留下字面量 @project.version@。 -->
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
